# Bind address for the inbox API.
HOST=127.0.0.1
# API port (on the VM inbox/.env sets 8810; 8000 is taken there).
PORT=8000
# Zetaris REST endpoint.
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
# Zetaris organisation id.
ZETARIS_ORG_ID=1
# Zetaris API key (placeholder only).
ZETARIS_API_KEY=your-zetaris-api-key
# Nightshift base URL; the port is whatever the Nightshift Console shows (8088 is the documented example).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Nightshift runtime token (placeholder only).
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Primary route, pinned to a Nemotron-backed lane by doctor.
NIGHTSHIFT_ROUTE_PRIMARY=<pinned by doctor, see 0.6>
# Fallback route when the primary fails.
NIGHTSHIFT_ROUTE_FALLBACK=meterless/local
# Per-call Nightshift timeout in milliseconds.
NIGHTSHIFT_TIMEOUT_MS=120000
# OpenJev typed-gates service base URL.
OPENJEV_BASE_URL=http://127.0.0.1:8080
# OpenJev API key (placeholder only).
OPENJEV_API_KEY=your-openjev-key
# HMAC secret Scout signs execution contracts with.
SCOUT_SECRET=change-me
# true runs on bundled sample data with no network.
SAMPLE_MODE=false
# true makes the first Zetaris call refuse once, to show recovery in the trace.
FAULT_ZETARIS_REFUSE_ONCE=false
# Log verbosity.
LOG_LEVEL=INFO
# Host folder shared with Zetaris for file loads.
ZETARIS_SHARED_DIR=/mnt/db/blastworks-dev/hackathon-zetaris/customer-data/shared/jedi-pack
# The same folder as Zetaris sees it.
ZETARIS_FILE_ROOT=file:///home/zetaris/customer-data/shared/jedi-pack
# Direct local lane (NOT through Nightshift): einh's Bionic server on Thor, via LM Link on this VM.
# Fires only when Nightshift itself is unreachable (connection refused or timeout), never on a Nightshift HTTP error.
# Disclosed in the README: a draft served here is neither NVIDIA nor Meterless. Empty LOCAL_LANE_BASE_URL disables it.
LOCAL_LANE_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LANE_MODELS=meta/muse-glimmer,ternary-bonsai-2-27b-mlx,qwen/qwen3.8-27b
LOCAL_LANE_TIMEOUT_MS=180000
